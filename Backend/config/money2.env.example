SPRING_CONFIG_ADDITIONAL_LOCATION=file:/home/money/money2/config/application-production.properties
MONEY2_DB_URL=jdbc:postgresql://127.0.0.1:5433/moneyapp
MONEY2_DB_USERNAME=money2_app
MONEY2_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
MONEY2_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

MONEY2_QDRANT_ENABLED=true
MONEY2_QDRANT_URL=http://127.0.0.1:6333
MONEY2_QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
MONEY2_QDRANT_COLLECTION=money2_clients
MONEY2_QDRANT_SYNC_DELAY_MS=60000
MONEY2_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://moneyapp.site,https://www.moneyapp.site

MONEY2_CODEX_ENABLED=true
MONEY2_CODEX_EXECUTABLE=/usr/local/bin/codex
MONEY2_CODEX_DATA_DIRECTORY=/home/money/money2/data/codex
MONEY2_CODEX_REQUEST_TIMEOUT_SECONDS=180
MONEY2_CODEX_MAX_PROCESSES=12
MONEY2_CODEX_IDLE_MINUTES=20
