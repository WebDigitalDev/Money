[Unit]
Description=Money API V2 Development HTTPS Tunnel
After=network-online.target money2.service
Wants=network-online.target money2.service

[Service]
Type=simple
User=money
Group=money
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8081
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=money2-tunnel

[Install]
WantedBy=multi-user.target
